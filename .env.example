PORT=3004
HOST=0.0.0.0
NODE_ENV=production
TRUST_PROXY=true

# Regional Identity (asia | europe | international)
REGION_ID=asia
REGION_NAME=Asia
MAX_PLAYERS=100

# Comma-separated allowed frontend origins (Tribe Rush Vercel + Game Lister Hub Vercel)
CORS_ORIGINS=https://your-triberush-client.vercel.app,https://game-lister.vercel.app

# Shared HMAC secret (must match GameListerServer JWT_SECRET if verifying SSO)
JWT_SECRET=replace_with_strong_secret_key

# Marble Games Hub Backend URL for Federated SSO Exchange
HUB_AUTH_API_URL=https://your-gamelister-server.onrender.com

# Supabase Project (shandelcruz)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
